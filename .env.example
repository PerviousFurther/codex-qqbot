QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_TRANSPORT=websocket
QQBOT_WEBHOOK_PORT=8080
# Sync the C2C bottom menu at startup and send replies using Markdown.
QQBOT_MENU_ENABLED=true
QQBOT_MARKDOWN=true
QQBOT_API_BASE_URL=https://api.bot.qq.com
# Optional explicit platform OpenIDs; these take precedence over first-message binding.
WATCH_ADMIN_OPENIDS=
# With no configured or saved admin, bind the first valid private-message sender.
WATCH_CLAIM_FIRST_ADMIN=true
# Initial group allowlist. Admins can authorize observed groups via private /groups.
WATCH_GROUP_OPENIDS=
WATCH_DATA_DIR=.state
# Separate Codex account/config directory; never reuse the development workspace.
# Authenticate separately: CODEX_HOME="$PWD/.auth/codex" codex login
WATCH_CODEX_HOME=.auth/codex
WATCH_BILIBILI_STATE=.auth/bilibili.json
# Host packages shared read-only with the Debian 13 container.
WATCH_HOST_OPENAI_DIR=/home/YUE___/.nvm/versions/node/v24.22.1/lib/node_modules/@openai
WATCH_HOST_BROWSERS_DIR=/home/YUE___/cloudcli-docker/data/home/.cache/ms-playwright
# Administrator-only MCP file tools restrict reads to source/docs within this mount.
WATCH_HOST_PROJECT_DIR=.

# Optional local ASR: paths in the runtime environment, never model tool input.
# Leave empty to use only QQ-provided ASR; see docs/audio-decoder.md.
WATCH_AUDIO_MODEL_DIR=
WATCH_AUDIO_VAD_MODEL=
WATCH_AUDIO_RUNTIME_DIR=
WATCH_AUDIO_THREADS=2
